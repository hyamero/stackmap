{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && bun install --frozen-lockfile",
  "buildCommand": "cd .. && bun run --filter @stackmap/viewer build && cd site && bun run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../packages ../bun.lock"
}
